NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:4200

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=edms
DB_USER=edms
DB_PASSWORD=edms_dev_password
DB_SSL=false
DB_SYNCHRONIZE=false

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_EXPIRES_IN=7d

LOCAL_ADMIN_ENABLE=false
LOCAL_ADMIN_USERNAME=superadmin
LOCAL_ADMIN_PASSWORD_HASH=scrypt$replace-with-hex-salt$replace-with-scrypt-hash
LOCAL_ADMIN_DISPLAY_NAME=EDMS Super Administrator

LDAP_ENABLE=false
LDAP_URL=ldap://127.0.0.1:389
LDAP_DN=service-account@example.local
LDAP_PASSWORD=replace-with-service-account-password
LDAP_BASE=dc=example,dc=local
LDAP_FILTER=(|(sAMAccountName={{username}})(userPrincipalName={{username}}))
LDAP_SEARCH=sAMAccountName
LDAP_CONNECT_TIMEOUT_MS=5000
LDAP_TIMEOUT_MS=5000
LDAP_ALLOW_INSECURE=false
HRIS_EMPLOYEE_URL=https://hris.example.local/api/employee/public

# Configure values for the target environment.
# Keep real .env outside source control. Existing deployments must preserve APP_KEY.
APP_NAME="MH E-Form"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
LOG_CHANNEL=stack
LOG_LEVEL=warning
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=edms_db
DB_USERNAME=
DB_PASSWORD=
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=no-reply@example.com
MAIL_FROM_NAME="MH E-Form"
FRONTEND_URL=https://frontend.example.com
FRONTEND_PRINT_BASE_URL=https://frontend.example.com

